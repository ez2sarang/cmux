#!/bin/zsh -f
# cmux-agent-state — 탭별 에이전트 상태(blocked/working/idle) 기록·조회 (cmux가 띄우는 claude의 훅 + cmux status/jump)
#
# 사용법:
#   cmux-agent-state hook <이벤트>     Claude Code 훅 진입점 — stdin(JSON)을 읽고 상태 파일을 갱신한다.
#                                      stdout 출력 없음·항상 exit 0 (PermissionRequest 훅은 출력이 곧 결정이라 특히 금지).
#   cmux-agent-state set <상태>        (시험용) 이 pane의 상태를 직접 기록 — blocked | working | idle
#   cmux-agent-state rollup [세션]     탭별 롤업 출력 — 줄마다 `탭<TAB>상태<TAB>ts`. 세션 생략 시 $ZELLIJ_SESSION_NAME.
#
# 환경변수: CMUX_TAB_NAME(탭 이름 — cmux launch가 export) · ZELLIJ_SESSION_NAME · ZELLIJ_PANE_ID (셋 중 하나라도 없으면 hook은 아무것도 안 한다)
#           CMUX_AGENT_STATE_DIR(기본 ~/.config/cmux/agent-state)
#
# 상태 파일: ${CMUX_AGENT_STATE_DIR}/<세션>/<pane_id>  — 내용 3줄 `state=<…>` `ts=<epoch초>` `tab=<탭 이름>`
#   쓰기는 같은 디렉터리의 임시 파일 → mv (원자적). 파일명은 숫자만 — 임시 파일(.…tmp.pid)은 읽기에서 무시된다.
#
# 이벤트 → 상태 (설계: .collar/tasks/20261030-1320-agent-state-badge.md "상태 매핑 확정")
#   SessionStart              idle (같은 세션에서 tab=이 같은 다른 pane 파일은 지운다 — 재시작 유령 방지)
#   UserPromptSubmit          working
#   PreToolUse                tool_name=AskUserQuestion 이면 blocked, 그 외 working(심박)
#   PermissionRequest         blocked
#   PostToolUse / …Failure    working
#   Notification              notification_type = permission_prompt | elicitation_dialog → blocked, idle_prompt → idle, 그 밖은 변경 없음
#   Stop / StopFailure        idle
#   SessionEnd                이 pane 상태 파일 삭제
#
# 읽기 규칙 (rollup — bin/cmux-bar의 read_agent_states와 같은 결과를 내야 한다. 시험이 대조한다)
#   탭 롤업 = blocked > working > idle. working인데 ts가 STALE_WORKING_SECS(300초) 넘게 갱신 없으면 idle로 본다
#   (ESC 중단은 Stop이 안 와서 working이 고착된다). ts가 ABANDON_SECS(12시간) 넘은 파일은 무시.
#   탭 이름은 파일 내용의 tab=으로 묶는다 (파일명 인코딩 문제 회피).

zmodload -F zsh/datetime p:EPOCHSECONDS
zmodload zsh/regex 2>/dev/null

typeset -gi STALE_WORKING_SECS=300
typeset -gi ABANDON_SECS=43200
typeset -g STATE_ROOT="${CMUX_AGENT_STATE_DIR:-${HOME}/.config/cmux/agent-state}"
typeset -gA _RANK=(blocked 3 working 2 idle 1)

# 파일 조작 — zsh/files 내장(포크 없음)이 있으면 그것을, 없으면 외부 명령
if zmodload -F zsh/files b:zf_mv b:zf_rm b:zf_mkdir 2>/dev/null; then
  _mv()    { zf_mv -f -- "$1" "$2" }
  _rm()    { zf_rm -f -- "$@" }
  _mkdir() { zf_mkdir -p -- "$1" }
else
  _mv()    { command mv -f -- "$1" "$2" }
  _rm()    { command rm -f -- "$@" }
  _mkdir() { command mkdir -p -- "$1" }
fi

# _sess_dirname <세션> → REPLY = 상태 디렉터리 이름 ('/'는 '_'로). 쓸 수 없는 이름이면 비0.
_sess_dirname() {
  REPLY="${1//\//_}"
  [[ -n "$REPLY" && "$REPLY" != (.|..) ]]
}

# _tab_key <이름> → REPLY = 줄바꿈·CR·TAB을 공백으로 (상태 파일·rollup 줄 형식 보호; cmux-bar·cmux status도 같은 규칙으로 맞춘다)
_tab_key() { REPLY="${1//[$'\n\r\t']/ }" }

# _write_state <디렉터리> <pane_id> <상태> <탭> — 임시 파일 + mv
_write_state() {
  local dir="$1" pane="$2" st="$3" tab="$4" tmp
  [[ -d "$dir" ]] || _mkdir "$dir" || return 1
  tmp="$dir/.$pane.tmp.$$"
  print -r -- "state=$st"$'\n'"ts=$EPOCHSECONDS"$'\n'"tab=$tab" > "$tmp" 2>/dev/null || { _rm "$tmp"; return 1 }
  _mv "$tmp" "$dir/$pane" 2>/dev/null || { _rm "$tmp"; return 1 }
}

# _drop_same_tab <디렉터리> <내 pane_id> <탭> — tab=이 같은 다른 pane 파일 삭제
_drop_same_tab() {
  local dir="$1" me="$2" tab="$3" f line content
  for f in "$dir"/<->(N); do
    [[ "${f:t}" == "$me" || ! -r "$f" ]] && continue
    content="$(<"$f")" 2>/dev/null || continue
    for line in "${(@f)content}"; do
      [[ "$line" == tab=* && "${line#tab=}" == "$tab" ]] && { _rm "$f"; break }
    done
  done
}

# _scan <디렉터리> — 탭별 롤업을 _R_tabs / _R_states / _R_ts 평행 배열에 채운다 (이름 순)
typeset -ga _R_tabs _R_states _R_ts
_scan() {
  local dir="$1" f line content st ts tab eff age i now=$EPOCHSECONDS
  _R_tabs=() _R_states=() _R_ts=()
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/<->(N); do
    [[ -r "$f" ]] || continue
    content="$(<"$f")" 2>/dev/null || continue
    st="" ts="" tab=""
    for line in "${(@f)content}"; do
      case "$line" in
        state=*) st="${line#state=}" ;;
        ts=*)    ts="${line#ts=}" ;;
        tab=*)   tab="${line#tab=}" ;;
      esac
    done
    [[ "$ts" == <-> && -n "$tab" ]] || continue
    age=$(( now - ts ))
    (( age < 0 )) && age=0
    (( age > ABANDON_SECS )) && continue
    case "$st" in
      working) if (( age > STALE_WORKING_SECS )); then eff=idle; else eff=working; fi ;;
      blocked|idle) eff="$st" ;;
      *) continue ;;
    esac
    i=${_R_tabs[(ie)$tab]}
    if (( i > ${#_R_tabs} )); then
      _R_tabs+=("$tab") _R_states+=("$eff") _R_ts+=("$ts")
    elif (( _RANK[$eff] > _RANK[${_R_states[i]}] )); then
      _R_states[i]="$eff" _R_ts[i]="$ts"
    elif [[ "$eff" == "${_R_states[i]}" ]] && (( ts > _R_ts[i] )); then
      _R_ts[i]="$ts"
    fi
  done
}

# 훅/set 공용: 환경 점검 → _dir _pane _tab 설정. 하나라도 없으면 비0.
_dir="" _pane="" _tab=""
_env_ok() {
  [[ -n "$CMUX_TAB_NAME" && -n "$ZELLIJ_SESSION_NAME" && "$ZELLIJ_PANE_ID" == <-> ]] || return 1
  _sess_dirname "$ZELLIJ_SESSION_NAME" || return 1
  _dir="$STATE_ROOT/$REPLY" _pane="$ZELLIJ_PANE_ID"
  _tab_key "$CMUX_TAB_NAME"; _tab="$REPLY"
  [[ -n "${_tab// /}" ]]
}

# _rx <JSON 문자열> <키> → REPLY = 그 키의 첫 문자열 값 ("키" : "값"), 없으면 비0
_rx() {
  REPLY=""
  [[ "$1" =~ "\"$2\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"" ]] || return 1
  REPLY="${match[1]}"
}

cmd_hook() {
  exec 2>/dev/null
  local ev="$1" payload="" st=""
  [[ -t 0 ]] || IFS= read -r -d '' payload      # stdin은 반드시 비운다 (EOF라 rc≠0 — 무시)
  _env_ok || return 0
  case "$ev" in
    SessionStart)      st=idle ;;
    UserPromptSubmit)  st=working ;;
    PreToolUse)        if _rx "$payload" tool_name && [[ "$REPLY" == AskUserQuestion ]]; then st=blocked; else st=working; fi ;;
    PermissionRequest) st=blocked ;;
    PostToolUse|PostToolUseFailure) st=working ;;
    Notification)
      _rx "$payload" notification_type || return 0
      case "$REPLY" in
        permission_prompt|elicitation_dialog) st=blocked ;;
        idle_prompt) st=idle ;;
        *) return 0 ;;
      esac ;;
    Stop|StopFailure)  st=idle ;;
    SessionEnd)        _rm "$_dir/$_pane"; return 0 ;;
    *)                 return 0 ;;
  esac
  [[ "$ev" == SessionStart ]] && _drop_same_tab "$_dir" "$_pane" "$_tab"
  _write_state "$_dir" "$_pane" "$st" "$_tab"
  return 0
}

cmd_set() {
  case "$1" in blocked|working|idle) ;; *) print -u2 -r -- "cmux-agent-state set: blocked | working | idle 중 하나여야 합니다"; return 2 ;; esac
  _env_ok || { print -u2 -r -- "cmux-agent-state set: CMUX_TAB_NAME · ZELLIJ_SESSION_NAME · ZELLIJ_PANE_ID(숫자)가 필요합니다"; return 1 }
  _write_state "$_dir" "$_pane" "$1" "$_tab"
}

cmd_rollup() {
  local sess="${1:-$ZELLIJ_SESSION_NAME}" i t
  _sess_dirname "$sess" || { print -u2 -r -- "cmux-agent-state rollup: 세션 이름이 필요합니다"; return 2 }
  _scan "$STATE_ROOT/$REPLY"
  local -a order=("${(@o)_R_tabs}")
  for t in "${order[@]}"; do
    i=${_R_tabs[(ie)$t]}
    print -r -- "$t"$'\t'"${_R_states[i]}"$'\t'"${_R_ts[i]}"
  done
}

case "$1" in
  hook)   cmd_hook "$2"; exit 0 ;;
  set)    cmd_set "$2"; exit $? ;;
  rollup) cmd_rollup "$2"; exit $? ;;
  *)      print -u2 -r -- "사용법: cmux-agent-state hook <이벤트> | set <blocked|working|idle> | rollup [세션]"; exit 2 ;;
esac
