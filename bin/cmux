#!/usr/bin/env zsh
# cmux — Claude Code 멀티 프로젝트 워크스페이스
#
# 사용법:
#   cmux                 세션 연결 / 이전 탭 복원 / 프로젝트 선택
#   cmux <경로>          경로 직접 열기 (기본 에이전트)
#   cmux -a <에이전트> [경로]  에이전트를 골라 열기 (경로 생략 시 현재 폴더)
#   cmux default [에이전트]    기본 에이전트 조회 / 설정
#   cmux pick            기록 무시하고 프로젝트 선택기 실행
#   cmux add [경로]      추가 경로 등록 (DEV_ROOT 외 경로용)
#   cmux rm              등록 경로 제거
#   cmux list            프로젝트 목록
#   cmux -l              zellij 세션 목록
#   cmux -k              세션 재시작 (같은 탭 복원 + 에이전트 대화 이어서)
#   cmux kill            세션 종료만 (탭 기록 보존)
#   cmux -h              도움말

# 사용자 설정 — zsh로 source (있을 때만, 오류는 무시). 예: CMUX_DEFAULT_AGENT=codex / CMUX_CODEX_PERM=auto
# 모든 서브커맨드(pane의 'cmux launch' 포함)가 맨 먼저 읽는다 — zellij 서버 env를 바꾸지 않아도 적용된다.
CMUX_CONFIG_FILE="${CMUX_CONFIG_FILE:-${HOME}/.config/cmux/config}"
[[ -f "$CMUX_CONFIG_FILE" && -r "$CMUX_CONFIG_FILE" ]] && { source "$CMUX_CONFIG_FILE" } 2>/dev/null

SESSION_NAME="${CMUX_SESSION:-claude}"
DEV_ROOT="${CMUX_ROOT:-${HOME}/Documents/dev/ai}"
EXTRAS_FILE="${CMUX_EXTRAS_FILE:-${HOME}/.config/cmux/projects}"
# 세션에 열려 있던 탭 기록 — 재시작·크래시 후 복원용. 줄마다 `경로`(claude) 또는 `경로<TAB>에이전트`
TABS_FILE="${CMUX_TABS_FILE:-${HOME}/.config/cmux/session-tabs}"
# 프로젝트별 마지막 사용 에이전트(`실제경로<TAB>에이전트`) — picker 사전선택 전용 ('cmux <경로>'엔 적용 안 함)
PROJECT_AGENTS_FILE="${CMUX_PROJECT_AGENTS_FILE:-${HOME}/.config/cmux/project-agents}"
# 프로젝트별 에이전트 실행 인자(`대상<TAB>에이전트<TAB>인자`) — 맞는 줄이 있으면 권한 프로파일 인자 대신 쓴다 (설계 §16)
AGENT_ARGS_FILE="${CMUX_AGENT_ARGS_FILE:-${HOME}/.config/cmux/agent-args}"
# 자기 자신의 절대 경로 (zellij pane 명령으로 사용)
CMUX_SELF="${0:A}"

# 에이전트 어댑터 (cmux 옆의 cmux-agents.zsh → 설치 위치 ~/.local/bin)
CMUX_AGENTS_LIB="${CMUX_SELF:h}/cmux-agents.zsh"
[[ -f "$CMUX_AGENTS_LIB" ]] || CMUX_AGENTS_LIB="${HOME}/.local/bin/cmux-agents.zsh"
if [[ ! -f "$CMUX_AGENTS_LIB" ]]; then
  echo "cmux: 에이전트 어댑터 파일이 없습니다 — ${CMUX_SELF:h}/cmux-agents.zsh (install.sh 로 다시 설치하세요)" >&2
  [[ -n "$CMUX_SOURCE_ONLY" ]] && return 1
  exit 1
fi
source "$CMUX_AGENTS_LIB"

# claude 바이너리 (도움말 표시용): CMUX_CLAUDE_BIN 환경변수 → brew → which
_agent_call claude bin && CLAUDE_BIN="$REPLY" || CLAUDE_BIN="claude"

# cmux-picker 바이너리 경로 (설치 위치 자동 탐색)
CMUX_PICKER_BIN="${CMUX_PICKER_BIN:-$(dirname "$0")/cmux-picker}"
[[ ! -x "$CMUX_PICKER_BIN" ]] && CMUX_PICKER_BIN="$(command -v cmux-picker 2>/dev/null || echo "")"

# cmux-bar 바이너리 경로
CMUX_BAR_BIN="${CMUX_BAR_BIN:-$(dirname "$0")/cmux-bar}"
[[ ! -x "$CMUX_BAR_BIN" ]] && CMUX_BAR_BIN="$(command -v cmux-bar 2>/dev/null || echo "")"

# zellij 레이아웃 디렉토리
ZELLIJ_LAYOUTS_DIR="${CMUX_LAYOUTS_DIR:-${HOME}/.config/zellij/layouts}"
SESSION_LAYOUT_FILE="${ZELLIJ_LAYOUTS_DIR}/cmux-session.kdl"

# ── 색상 ──────────────────────────────────────────────
_c_cyan="\033[36m"
_c_green="\033[32m"
_c_yellow="\033[33m"
_c_gray="\033[90m"
_c_reset="\033[0m"

_info()  { echo "${_c_cyan}▶${_c_reset} $*" }
_ok()    { echo "${_c_green}✓${_c_reset} $*" }
_warn()  { echo "${_c_yellow}!${_c_reset} $*" }

# ── 유틸 ──────────────────────────────────────────────
_ensure_extras_file() {
  mkdir -p "$(dirname "$EXTRAS_FILE")"
  touch "$EXTRAS_FILE"
}

_clear_session_cache() {
  local cache="${HOME}/Library/Caches/org.Zellij-Contributors.Zellij/contract_version_1/session_info/${SESSION_NAME}"
  rm -rf "$cache" 2>/dev/null || true
}

# DEV_ROOT 하위 폴더 + EXTRAS_FILE 합쳐서 후보 목록 생성
_project_list() {
  if [[ -d "$DEV_ROOT" ]]; then
    for d in "$DEV_ROOT"/*/; do
      [[ -d "$d" ]] && echo "${d%/}"
    done
  fi

  if [[ -f "$EXTRAS_FILE" ]]; then
    while IFS= read -r p; do
      [[ -z "$p" ]] && continue
      [[ "$p" == "$DEV_ROOT/"* ]] && continue
      echo "$p"
    done < "$EXTRAS_FILE"
  fi
}

# ── 세션 상태 ─────────────────────────────────────────
# 살아 있으면 0. EXITED(부활 캐시만 남은 상태)면 정리하고 1.
_session_alive() {
  local line
  line=$(zellij list-sessions --no-formatting 2>/dev/null | grep -E "^${SESSION_NAME}"'( |$)' | head -1)
  [[ -z "$line" ]] && return 1
  if [[ "$line" == *EXITED* ]]; then
    zellij delete-session "$SESSION_NAME" --force 2>/dev/null || true
    _clear_session_cache
    return 1
  fi
  return 0
}

# ── 탭 spec ───────────────────────────────────────────
# 탭 하나 = spec: `경로` 또는 `경로<TAB>에이전트` (TAB 없음 = claude). 받는 쪽은 항상 _spec_parse로 해석한다.
# 정규형(기록 줄) = claude는 `경로`만, 그 외 `경로<TAB>에이전트` — 구버전 cmux 호환 (설계 §4)
# _spec_parse <spec> → reply=(경로 에이전트)
_spec_parse() {
  if [[ "$1" == *$'\t'* ]]; then
    reply=("${1%$'\t'*}" "${${1##*$'\t'}:-claude}")
  else
    reply=("$1" claude)
  fi
}

# _tab_name <경로> [에이전트] → REPLY = 탭 이름. claude는 basename(현행 그대로), 그 외는 basename·에이전트
_tab_name() {
  if [[ "${2:-claude}" == claude ]]; then
    REPLY="${1:t}"
  else
    REPLY="${1:t}·$2"
  fi
}

# ── 기본 에이전트 ─────────────────────────────────────
# _default_agent → REPLY (출처 → _cmux_default_src). env CMUX_AGENT > 설정 CMUX_DEFAULT_AGENT > claude.
# 등록되지 않은 값은 경고 1줄(stderr, 프로세스당 1회) 후 claude.
_default_agent() {
  if [[ -z "$_cmux_default_agent" ]]; then
    local a src
    if [[ -n "$CMUX_AGENT" ]]; then
      a="$CMUX_AGENT" src="환경변수 CMUX_AGENT"
    elif [[ -n "$CMUX_DEFAULT_AGENT" ]]; then
      a="$CMUX_DEFAULT_AGENT" src="설정 CMUX_DEFAULT_AGENT — $CMUX_CONFIG_FILE"
    else
      a=claude src="기본값"
    fi
    if ! _agent_known "$a"; then
      _warn "기본 에이전트 '${a}'(${src%% — *})는 등록되지 않았습니다 — claude를 씁니다 (사용 가능: ${CMUX_AGENTS[*]})" >&2
      a=claude src="기본값"
    fi
    typeset -g _cmux_default_agent="$a" _cmux_default_src="$src"
  fi
  REPLY="$_cmux_default_agent"
}

# _config_set_default <에이전트> — 설정 파일의 CMUX_DEFAULT_AGENT= 줄을 바꾼다(없으면 추가, 다른 줄 보존).
# 파일·디렉토리가 없으면 만든다. 원자적(같은 디렉토리 tmp → mv). 실패하면 비0.
_config_set_default() {
  local f="${CMUX_CONFIG_FILE:A}"
  local tmp="${f}.tmp.$$"
  mkdir -p "${f:h}" 2>/dev/null
  [[ -d "${f:h}" && -w "${f:h}" ]] || return 1
  {
    if [[ -f "$f" ]]; then
      awk -v line="CMUX_DEFAULT_AGENT=$1" '
        /^[[:space:]]*(export[[:space:]]+)?CMUX_DEFAULT_AGENT=/ { if (!done) print line; done = 1; next }
        { print }
        END { if (!done) print line }' "$f"
    else
      print -r -- "CMUX_DEFAULT_AGENT=$1"
    fi
  } > "$tmp" && mv -f -- "$tmp" "$f" && return 0
  rm -f -- "$tmp"
  return 1
}

# _agent_remember <spec...> — 마지막 사용 에이전트 기억 (설계 D5 — picker 사전선택 전용)
# PROJECT_AGENTS_FILE에 `실제경로<TAB>에이전트`. 같은 경로 줄은 교체(중복 줄은 하나로), 나머지 줄 보존,
# 원자적(tmp → mv). 파일·디렉토리가 없으면 만들고, 실패해도 조용히 넘어간다(탭 열기는 계속) — 항상 0.
_agent_remember() {
  local f="$PROJECT_AGENTS_FILE" s p line
  local -A want
  local -a order
  for s in "$@"; do
    [[ -z "$s" ]] && continue
    _spec_parse "$s"
    p="${reply[1]:A}"
    (( ${+want[$p]} )) || order+=("$p")
    want[$p]="${reply[2]}"
  done
  (( ${#order} )) || return 0
  mkdir -p "${f:h}" 2>/dev/null
  [[ -d "${f:h}" && -w "${f:h}" ]] || return 0
  local tmp="${f}.tmp.$$"
  {
    if [[ -f "$f" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        p="${line%%$'\t'*}"
        if [[ -n "$p" ]] && (( ${+want[$p]} )); then
          if [[ -n "${want[$p]}" ]]; then print -r -- "$p"$'\t'"${want[$p]}"; fi
          want[$p]=""    # 교체 완료 — 같은 경로의 다음 줄은 버린다
          continue
        fi
        print -r -- "$line"
      done < "$f"
    fi
    for p in "${order[@]}"; do
      if [[ -n "${want[$p]}" ]]; then print -r -- "$p"$'\t'"${want[$p]}"; fi
    done
  } > "$tmp" 2>/dev/null && mv -f -- "$tmp" "$f" 2>/dev/null
  rm -f -- "$tmp" 2>/dev/null
  return 0
}

# ── 탭 구성 기록 ──────────────────────────────────────
# 기록된 탭 중 경로가 실제로 존재하는 것만 순서대로, 정규형 spec(claude `경로` / 그 외 `경로<TAB>에이전트`)으로 출력.
# 같은 spec은 처음 것만(손으로 쓴 `경로<TAB>claude`도 `경로`). TAB 뒤가 등록된 에이전트가 아니면
# 줄 전체를 경로로 본다(대개 없는 경로라 건너뜀).
_tabs_load() {
  [[ -f "$TABS_FILE" ]] || return 0
  local line p a
  local -aU out
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    p="$line" a=claude
    if [[ "$line" == *$'\t'* ]] && _agent_known "${line##*$'\t'}"; then
      p="${line%$'\t'*}" a="${line##*$'\t'}"
    fi
    [[ -d "$p" ]] || continue
    _tabs_line "$p"$'\t'"$a"
    out+=("$REPLY")
  done < "$TABS_FILE"
  (( ${#out} )) && print -rl -- "${out[@]}"
  return 0
}

# _tabs_line <spec> → REPLY = 기록 줄 (claude는 `경로`만, 그 외 `경로<TAB>에이전트`)
_tabs_line() {
  _spec_parse "$1"
  if [[ "${reply[2]}" == claude ]]; then
    REPLY="${reply[1]}"
  else
    REPLY="${reply[1]}"$'\t'"${reply[2]}"
  fi
}

# _tabs_backup <기록 줄...> — 비-claude 줄(TAB)을 처음 쓰기 직전, 기존 기록(아직 TAB 줄 없음 = 구포맷)을
# session-tabs.bak-<YYYYMMDD>로 1회 보존한다. 그날 백업이 이미 있으면 건너뛴다.
_tabs_backup() {
  [[ "${(j::)@}" == *$'\t'* && -s "$TABS_FILE" ]] || return 0
  grep -q $'\t' "$TABS_FILE" 2>/dev/null && return 0
  local day
  strftime -s day '%Y%m%d' $EPOCHSECONDS
  [[ -e "${TABS_FILE}.bak-$day" ]] || cp -p -- "$TABS_FILE" "${TABS_FILE}.bak-$day" 2>/dev/null
  return 0
}

# 기록 전체 덮어쓰기 (spec 인자들, 순서 유지 — 같은 spec은 처음 것만)
_tabs_save() {
  mkdir -p "$(dirname "$TABS_FILE")"
  local s
  local -aU lines
  for s in "$@"; do
    [[ -z "$s" ]] && continue
    _tabs_line "$s"
    lines+=("$REPLY")
  done
  _tabs_backup "${lines[@]}"
  : > "$TABS_FILE"
  (( ${#lines} )) && print -rl -- "${lines[@]}" >> "$TABS_FILE"
  return 0
}

# 없는 spec만 뒤에 추가 (순서 유지, 중복 제거 — 같은 경로라도 에이전트가 다르면 별개)
_tabs_append() {
  mkdir -p "$(dirname "$TABS_FILE")"
  touch "$TABS_FILE"
  local s
  for s in "$@"; do
    [[ -z "$s" ]] && continue
    _tabs_line "$s"
    grep -qxF -- "$REPLY" "$TABS_FILE" 2>/dev/null && continue
    # claude는 손으로 쓴 `경로<TAB>claude` 줄도 같은 spec
    [[ "${reply[2]}" == claude ]] && grep -qxF -- "${reply[1]}"$'\t'claude "$TABS_FILE" 2>/dev/null && continue
    _tabs_backup "$REPLY"
    print -r -- "$REPLY" >> "$TABS_FILE"
  done
}

# 살아 있는 세션의 실제 탭 순서로 기록 정리 (kill/restart 직전에 호출)
_tabs_sync_live() {
  _session_alive || return 0

  local names
  if [[ -n "$ZELLIJ" ]]; then
    names=$(zellij action query-tab-names 2>/dev/null)
  else
    names=$(zellij -s "$SESSION_NAME" action query-tab-names 2>/dev/null)
  fi
  [[ $? -ne 0 || -z "$names" ]] && return 0

  # 후보: 기존 기록(우선) + 프로젝트 목록. 탭 이름(basename[·에이전트])으로 경로를 역추적한다.
  # 비교는 `경로<TAB>에이전트`로 펼친 형태로 한다.
  local -a recorded projects specs
  local n base agent c hit unmapped=0
  recorded=()
  for c in "${(@f)$(_tabs_load)}"; do
    [[ -z "$c" ]] && continue
    _spec_parse "$c"
    recorded+=("${reply[1]}"$'\t'"${reply[2]}")
  done
  projects=("${(@f)$(_project_list)}")
  projects=("${(@)projects:#}")
  specs=()

  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    # 마지막 '·' 뒤가 등록된 에이전트일 때만 분리 — 아니면 이름 전체가 basename(claude 탭)
    base="$n" agent=claude
    if [[ "$n" == *·* ]] && _agent_known "${n##*·}"; then
      base="${n%·*}" agent="${n##*·}"
    fi
    hit=""
    for c in "${recorded[@]}"; do
      [[ "${c##*$'\t'}" == "$agent" && "${${c%$'\t'*}:t}" == "$base" ]] || continue
      # 이미 다른 탭에 배정된 spec은 제외 — 같은 이름의 프로젝트 2개를 구분
      (( ${specs[(Ie)$c]} )) && continue
      hit="$c"
      break
    done
    if [[ -z "$hit" ]]; then
      for c in "${projects[@]}"; do
        [[ "${c:t}" == "$base" ]] || continue
        (( ${specs[(Ie)$c$'\t'$agent]} )) && continue
        hit="$c"$'\t'"$agent"
        break
      done
    fi
    if [[ -n "$hit" ]]; then
      specs+=("$hit")
    else
      (( unmapped++ ))
    fi
  done <<< "$names"

  if (( unmapped > 0 )); then
    # 이름을 바꾼 탭 등 경로를 알 수 없는 탭이 있으면 기존 기록을 버리지 않고 병합
    for c in "${recorded[@]}"; do
      (( ${specs[(Ie)$c]} )) || specs+=("$c")
    done
    _warn "경로를 알 수 없는 탭 ${unmapped}개 — 기존 기록과 병합해 보존합니다" >&2
  fi

  [[ ${#specs[@]} -gt 0 ]] && _tabs_save "${specs[@]}"
  return 0
}

# ── zellij 클라이언트 실행 + 재시작 감시 ──────────────
# 'cmux -k'를 세션 안에서 실행하면 이 마커를 남기고 세션을 죽인다.
# 클라이언트가 종료된 뒤 마커가 있으면 같은 터미널에서 즉시 같은 탭으로 복원한다.
RESTART_MARKER="${TABS_FILE}.restart"

_run_client() {
  rm -f "$RESTART_MARKER"
  zellij "$@"
  local rc=$?

  if [[ -f "$RESTART_MARKER" ]]; then
    rm -f "$RESTART_MARKER"
    _info "세션 재시작 중..."
    local waited=0
    while _session_alive && (( waited < 60 )); do
      sleep 0.1
      (( waited++ ))
    done
    _clear_session_cache
    if _restore_tabs; then
      exit 0
    fi
    _warn "복원할 탭 기록 없음 — 프로젝트를 선택하세요."
    _pick_flow
    exit $?
  fi
  exit $rc
}

# ── KDL 탭 블록 생성 ──────────────────────────────────
# 탭 본문(에이전트 pane 65% | 파일트리 / 터미널) — 들여쓰기 0. 세션 레이아웃(_kdl_tab)과 new-tab 레이아웃
# (_kdl_tab_layout)이 같이 쓴다. claude는 기존과 같은 `args "launch"`·pane 이름 claude,
# 그 외는 `args "launch" "--agent" "<에이전트>"`·pane 이름 = 에이전트.
_kdl_tab_body() {
  local agent="${1:-claude}"
  local escaped_self="${CMUX_SELF//\\/\\\\}"
  escaped_self="${escaped_self//\"/\\\"}"
  local launch_args='"launch"'
  [[ "$agent" != claude ]] && launch_args+=" \"--agent\" \"${agent}\""

  cat <<KDL
pane split_direction="vertical" {
    pane size="65%" focus=true name="${agent}" {
        command "$escaped_self"
        args ${launch_args}
    }
    pane size="35%" split_direction="horizontal" {
        pane size="55%" name="files" {
            command "/bin/zsh"
            args "-c" "eza --tree --level 2 --icons --color=always . 2>/dev/null || ls -la .; exec zsh -i"
        }
        pane size="45%" name="terminal"
    }
}
KDL
}

# _kdl_tab <경로> <탭 이름> [focus(true|false)] [에이전트(기본 claude)] — 세션 레이아웃의 tab 블록
_kdl_tab() {
  local dir="$1"
  local name="$2"
  local focus="${3:-false}"

  local focus_attr=""
  [[ "$focus" == "true" ]] && focus_attr=" focus=true"

  local escaped_dir="${dir//\\/\\\\}"
  escaped_dir="${escaped_dir//\"/\\\"}"
  local escaped_name="${name//\"/\\\"}"
  local -a body=("${(@f)$(_kdl_tab_body "${4:-claude}")}")

  print -r -- "    tab name=\"$escaped_name\" cwd=\"$escaped_dir\"$focus_attr {"
  print -rl -- "${(@)body/#/        }"
  print -r -- "    }"
}

# _bar_pane <들여쓰기> — 상단 바 pane KDL. cmux-bar가 있으면 직접 그리는 탭 줄+툴바(내용 2행 = size=3, 탭 줄 1↔2줄 토글;
# zellij 0.45.1은 터미널 pane의 마지막 한 행을 쓸 수 없고 1행 pane은 렌더링하지 않는다. 상단 총 3행),
# 없으면 네이티브 zellij:tab-bar 플러그인(size=1)으로 폴백한다. claude-*.kdl.tmpl과 같은 규칙.
_bar_pane() {
  local ind="$1"
  if [[ -n "$CMUX_BAR_BIN" && -x "$CMUX_BAR_BIN" ]]; then
    print -r -- "${ind}pane size=3 borderless=true {
${ind}    command \"/bin/zsh\"
${ind}    args \"-c\" \"while true; do ${CMUX_BAR_BIN}; sleep 1; done\"
${ind}}"
  else
    print -r -- "${ind}pane size=1 borderless=true {
${ind}    plugin location=\"zellij:tab-bar\"
${ind}}"
  fi
}

# _kdl_tab_layout <에이전트> — new-tab 전용 탭 레이아웃 (claude-tab.kdl.tmpl과 같은 구조: cmux-bar(없으면 탭바)·본문·상태바).
# new-tab -l 은 세션 default_tab_template을 적용하지 않으므로 바들을 직접 포함한다. 에이전트 인자만 다르다.
_kdl_tab_layout() {
  local bar_block
  bar_block="$(_bar_pane "    ")"
  local -a body=("${(@f)$(_kdl_tab_body "${1:-claude}")}")

  cat <<KDL
layout {
${bar_block}
${(F)${(@)body/#/    }}
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
KDL
}

# _tab_layout <에이전트> → REPLY = new-tab -l 에 줄 레이아웃 이름 (--layout-dir ZELLIJ_LAYOUTS_DIR).
# claude는 설치된 claude-tab, 그 외는 cmux-tab-<에이전트>.kdl을 매번 생성(원자적 tmp → mv)해 쓴다. 생성 실패면 비0.
_tab_layout() {
  local agent="${1:-claude}"
  if [[ "$agent" == claude ]]; then
    REPLY="claude-tab"
    return 0
  fi
  REPLY="cmux-tab-${agent}"
  local f="${ZELLIJ_LAYOUTS_DIR}/${REPLY}.kdl"
  mkdir -p "$ZELLIJ_LAYOUTS_DIR" 2>/dev/null
  if _kdl_tab_layout "$agent" 2>/dev/null > "$f.tmp.$$" && mv -f -- "$f.tmp.$$" "$f" 2>/dev/null; then
    return 0
  fi
  rm -f -- "$f.tmp.$$" 2>/dev/null
  _warn "탭 레이아웃을 만들지 못했습니다: $f" >&2
  return 1
}

# 세션 레이아웃 파일 생성 (spec 인자들)
_make_layout() {
  local tmpfile="$SESSION_LAYOUT_FILE"
  mkdir -p "$ZELLIJ_LAYOUTS_DIR"

  local bar_block
  bar_block="$(_bar_pane "        ")"

  cat > "$tmpfile" <<HEADER
layout {
    default_tab_template {
${bar_block}
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
HEADER

  # 포커스 탭: LAYOUT_FOCUS_SPEC 이 지정되면 그 탭, 아니면 첫 탭
  _spec_parse "${LAYOUT_FOCUS_SPEC:-$1}"
  local focus_spec="${reply[1]}"$'\t'"${reply[2]}"
  local spec dir agent name
  for spec in "$@"; do
    _spec_parse "$spec"
    dir="${reply[1]}" agent="${reply[2]}"
    _tab_name "$dir" "$agent"
    name="$REPLY"
    if [[ "$dir"$'\t'"$agent" == "$focus_spec" ]]; then
      _kdl_tab "$dir" "$name" "true" "$agent" >> "$tmpfile"
    else
      _kdl_tab "$dir" "$name" "false" "$agent" >> "$tmpfile"
    fi
  done
  echo "}" >> "$tmpfile"
}

# 세션에 클라이언트(터미널)가 붙어 있으면 0
_client_attached() {
  zellij -s "$SESSION_NAME" action list-clients 2>/dev/null | tail -n +2 | grep -q .
}

# 살아 있는 세션에 연결하면서 탭 추가
# zellij 0.45.1은 클라이언트가 없는 세션에 new-tab -l 을 넣으면 레이아웃 적용에 실패하고
# ("Not enough room for panes") 다음 attach 때 그 탭을 버린다 — CLI는 성공 코드를 돌려준다.
# → 먼저 attach하고, 클라이언트가 붙은 것을 확인한 뒤 백그라운드에서 탭을 추가한다.
_attach_then_add_tabs() {
  local -a specs=("$@")
  (
    local i=0
    while (( i < 50 )) && ! _client_attached; do
      sleep 0.1
      (( i++ ))
    done
    # 클라이언트가 끝내 붙지 않았으면(attach 실패) 탭을 만들지도 기록하지도 않는다
    _client_attached || exit 0
    sleep 0.3
    local first_name="" spec dir agent name
    for spec in "${specs[@]}"; do
      _spec_parse "$spec"
      dir="${reply[1]}" agent="${reply[2]}"
      _tab_name "$dir" "$agent"
      name="$REPLY"
      _tab_layout "$agent" || continue
      zellij -s "$SESSION_NAME" action new-tab \
        -l "$REPLY" \
        --layout-dir "$ZELLIJ_LAYOUTS_DIR" \
        -n "$name" \
        -c "$dir" \
      && _tabs_append "$spec" \
      && _agent_remember "$spec" \
      && [[ -z "$first_name" ]] && first_name="$name"
    done
    sleep 0.3
    [[ -n "$first_name" ]] && zellij -s "$SESSION_NAME" action go-to-tab-name "$first_name"
  ) </dev/null >/dev/null 2>&1 &
  _run_client attach "$SESSION_NAME"
}

# ── 프로젝트 열기 (단일) ──────────────────────────────
# _open_one <spec> [탭 이름]
_open_one() {
  _spec_parse "$1"
  local dir="${reply[1]}" agent="${reply[2]}"
  local spec="$dir"$'\t'"$agent"
  _tab_name "$dir" "$agent"
  local name="${2:-$REPLY}"

  if [[ ! -d "$dir" ]]; then
    _warn "디렉토리가 없습니다: $dir" >&2
    return 1
  fi

  _info "프로젝트 열기: $name"

  if [[ -n "$ZELLIJ" ]]; then
    if _tab_layout "$agent"; then
      zellij action new-tab \
        -l "$REPLY" \
        --layout-dir "$ZELLIJ_LAYOUTS_DIR" \
        -n "$name" \
        -c "$dir" \
      && _tabs_append "$spec" \
      && _agent_remember "$spec"
    fi
    sleep 0.5
    zellij action go-to-tab-name "$name"
    sleep 0.3
  elif _session_alive; then
    # 살아 있는 세션은 절대 죽이지 않는다 — 연결한 뒤 탭 추가
    _attach_then_add_tabs "$spec"
  else
    # 세션이 죽은 상태에서 경로를 직접 열면 이전 탭 기록을 버리지 않고 함께 복원
    # (picker로 고른 새 구성은 CMUX_FRESH=1 이라 기록을 대체)
    local -a specs=()
    if [[ -z "$CMUX_FRESH" ]]; then
      _tabs_line "$spec"   # _tabs_load와 같은 정규형으로 비교
      specs=("${(@f)$(_tabs_load)}")
      specs=("${(@)specs:#}")
      specs=("${(@)specs:#$REPLY}")
    fi
    if [[ ${#specs[@]} -gt 0 ]]; then
      _info "이전 세션 탭 ${#specs[@]}개도 함께 복원 — 새 구성으로 시작하려면 'cmux pick'"
    fi
    specs+=("$spec")
    _tabs_save "${specs[@]}"
    _agent_remember "${specs[@]}"
    cd "$dir"
    LAYOUT_FOCUS_SPEC="$spec" _make_layout "${specs[@]}"
    _run_client -s "$SESSION_NAME" -n "$SESSION_LAYOUT_FILE"
  fi
}

# ── 프로젝트 열기 (다중) ─────────────────────────────
# _open_many <spec...>
_open_many() {
  local -a specs=("$@")
  local spec dir agent name

  if [[ -n "$ZELLIJ" ]]; then
    local first_name=""
    for spec in "${specs[@]}"; do
      _spec_parse "$spec"
      dir="${reply[1]}" agent="${reply[2]}"
      _tab_name "$dir" "$agent"
      name="$REPLY"
      _info "탭 추가: $name"
      _tab_layout "$agent" || continue
      zellij action new-tab \
        -l "$REPLY" \
        --layout-dir "$ZELLIJ_LAYOUTS_DIR" \
        -n "$name" \
        -c "$dir" \
      && _tabs_append "$spec" \
      && _agent_remember "$spec" \
      && [[ -z "$first_name" ]] && first_name="$name"
    done
    sleep 0.5
    [[ -n "$first_name" ]] && zellij action go-to-tab-name "$first_name"
    sleep 0.3
  elif _session_alive; then
    # 살아 있는 세션은 절대 죽이지 않는다 — 연결한 뒤 탭 추가
    for spec in "${specs[@]}"; do
      _spec_parse "$spec"
      _tab_name "${reply[1]}" "${reply[2]}"
      _info "탭 추가: $REPLY"
    done
    _attach_then_add_tabs "${specs[@]}"
  else
    _info "프로젝트 ${#specs[@]}개 탭 생성 중..."
    _tabs_save "${specs[@]}"
    _agent_remember "${specs[@]}"
    _make_layout "${specs[@]}"
    _run_client -s "$SESSION_NAME" -n "$SESSION_LAYOUT_FILE"
  fi
}

# 기록된 탭 복원 (있으면 0, 없으면 1)
_restore_tabs() {
  local -a restore
  restore=("${(@f)$(_tabs_load)}")
  restore=("${(@)restore:#}")  # 빈 요소 제거

  [[ ${#restore[@]} -eq 0 ]] && return 1

  _info "이전 세션 복원: ${#restore[@]}개 탭 (에이전트 대화 이어서) — 다른 구성을 고르려면 'cmux pick'"
  if [[ ${#restore[@]} -eq 1 ]]; then
    _open_one "${restore[1]}"
  else
    _open_many "${restore[@]}"
  fi
  return 0
}

# ── 프로젝트 피커 ──────────────────────────────────────
# picker 출력: 줄마다 `경로`(= default 에이전트) 또는 `경로<TAB>에이전트`.
# picker에 넘기는 env — CMUX_PICKER_AGENTS: 등록 에이전트 중 실행 파일이 실제로 있는 것(default는 항상, 등록 순서),
# CMUX_PICKER_DEFAULT_AGENT: default, CMUX_PICKER_PREFS_FILE: 마지막 사용 기억(사전선택).
# fzf 폴백(picker 없음)은 경로만 낸다 → 모두 default 에이전트.
_pick() {
  if [[ -n "$CMUX_PICKER_BIN" && -x "$CMUX_PICKER_BIN" ]]; then
    _default_agent
    local def="$REPLY" a
    local -a avail=()
    for a in "${CMUX_AGENTS[@]}"; do
      if [[ "$a" == "$def" ]] || { _agent_call "$a" bin && command -v -- "$REPLY" >/dev/null 2>&1 }; then
        avail+=("$a")
      fi
    done
    CMUX_ROOT="$DEV_ROOT" \
    CMUX_PICKER_AGENTS="${avail[*]}" \
    CMUX_PICKER_DEFAULT_AGENT="$def" \
    CMUX_PICKER_PREFS_FILE="$PROJECT_AGENTS_FILE" \
      "$CMUX_PICKER_BIN"
  else
    _project_list \
      | awk -F'/' '{print $NF "\t" $0}' \
      | sort -f \
      | fzf --multi --with-nth=1 --delimiter='\t' --prompt=" 프로젝트 > " \
            --height=80% --layout=reverse --border=rounded \
      | cut -f2
  fi
}

# 피커 실행 → 선택 결과로 열기
_pick_flow() {
  # default 해석(잘못된 값 경고 포함)은 picker 출력 캡처 밖에서 1회
  _default_agent
  local def="$REPLY"

  # picker 출력과 종료 코드를 분리 캡처 — 실패(exit≠0)와 취소(exit 0)를 구분
  local pick_out pick_status
  pick_out="$(_pick)"
  pick_status=$?

  local -a selected
  selected=("${(@f)pick_out}")
  selected=("${(@)selected:#}")  # 빈 요소 제거 (빈 출력 → 빈 배열)

  if [[ $pick_status -ne 0 && ${#selected[@]} -eq 0 ]]; then
    _warn "프로젝트 선택기 실행 실패 (exit $pick_status) — 위 오류 메시지를 확인하세요."
    _warn "우회: 'cmux list'로 목록 확인 또는 'cmux <경로>'로 직접 열기"
    exit 1
  fi

  if [[ ${#selected[@]} -eq 0 ]]; then
    _info "취소됨"
    exit 0
  fi

  # 줄 = `경로` 또는 `경로<TAB>에이전트` → spec. 경로 검사는 경로 부분만, 등록되지 않은 에이전트는 경고 후 default
  local -a valid=()
  local line d a
  for line in "${selected[@]}"; do
    d="$line" a="$def"
    [[ "$line" == *$'\t'* ]] && d="${line%$'\t'*}" a="${line##*$'\t'}"
    if [[ ! -d "$d" ]]; then
      _warn "경로 없음 (건너뜀): $d"
      continue
    fi
    if ! _agent_known "$a"; then
      _warn "알 수 없는 에이전트 '${a}' — 기본 에이전트(${def})로 엽니다: ${d:t}"
      a="$def"
    fi
    valid+=("$d"$'\t'"$a")
  done

  if [[ ${#valid[@]} -eq 0 ]]; then
    _warn "선택된 유효 경로가 없습니다."
    exit 1
  fi

  # picker로 고른 구성은 "새 구성" — 세션이 없을 때 이전 기록을 대체한다
  CMUX_FRESH=1
  if [[ ${#valid[@]} -eq 1 ]]; then
    _open_one "${valid[1]}"
  else
    _open_many "${valid[@]}"
  fi
}

# ── 에이전트 실행 (pane 진입점) ───────────────────────
# 핸드오프 마커 .collar/restart-fresh (설계 §6) — 수동 collar-handoff 성공 때만 collar가 쓴다.
# 내용은 줄마다 키 하나: agent=<이름> / handoff=<HANDOFF 파일명|-> / ts=<epoch 초>.
# _handoff_marker_due <에이전트> <디렉토리> <지금(epoch 초)> — 이 에이전트가 소비할 마커면 0
#   agent= 일치 && ts가 48시간 안 && 그 에이전트의 마지막 대화 활동 ≤ ts + CMUX_HANDOFF_GRACE(기본 300초).
#   유예가 필요한 이유: collar-handoff 명령의 출력은 마커를 쓴 직후 트랜스크립트에 기록되므로 "활동 ≤ ts"는
#   정상 흐름에서도 거짓이다. 유예보다 늦은 활동 = 핸드오프 뒤에 대화를 이어간 것 → 이어하기가 맞다.
#   다른 에이전트용·TTL 초과·유예 초과 마커는 건드리지 않는다. 깨진·빈 마커는 조용히 무시.
_handoff_marker_due() {
  local agent="$1" file="$2/.collar/restart-fresh" now="$3" line m_agent="" m_ts=""
  local grace="${CMUX_HANDOFF_GRACE:-300}"
  [[ "$grace" == <-> ]] || grace=300
  [[ -f "$file" && -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      agent=*) m_agent="${line#agent=}" ;;
      ts=*)    m_ts="${line#ts=}" ;;
    esac
  done < "$file"
  [[ "$m_agent" == "$agent" && "$m_ts" == <-> ]] || return 1
  (( now - m_ts <= 172800 )) || return 1
  _agent_call "$agent" last_activity "$2"
  (( REPLY <= m_ts + grace ))
}

# _handoff_marker_consume <에이전트> — $PWD의 마커를 소비했으면 0.
#   소비 = .collar/.restart-fresh.consumed-<epoch>로 원자적 mv. mv 실패 = 다른 pane이 먼저 소비 → 마커 없음과 같다.
_handoff_marker_consume() {
  local now=$EPOCHSECONDS
  _handoff_marker_due "$1" "$PWD" "$now" || return 1
  mv -- "$PWD/.collar/restart-fresh" "$PWD/.collar/.restart-fresh.consumed-$now" 2>/dev/null
}

# 비-claude 에이전트 시작 전 AGENTS.md의 collar 블록 갱신 (collar-agents-sync <dir>, 설계 §8)
# $PWD/.collar가 있고 PATH에 collar-agents-sync가 있을 때만. 2초 타임박스(넘으면 종료시키고 진행), 출력은 버린다.
# 실패해도 launch는 계속 — exit 2(블록 마커 손상)·3(AGENTS.md가 심볼릭 링크)만 경고 1줄.
_collar_agents_sync() {
  [[ -d "$PWD/.collar" ]] || return 0
  local sync rc i=0
  sync="$(command -v collar-agents-sync 2>/dev/null)" || return 0
  "$sync" "$PWD" </dev/null >/dev/null 2>&1 &
  local pid=$!
  while kill -0 $pid 2>/dev/null && (( i++ < 20 )); do sleep 0.1; done
  if kill -0 $pid 2>/dev/null; then
    kill $pid 2>/dev/null
    wait $pid 2>/dev/null
    return 0
  fi
  wait $pid
  rc=$?
  case $rc in
    2) _warn "AGENTS.md의 collar 블록 마커가 깨져 갱신하지 않았습니다 (collar-agents-sync exit 2)" ;;
    3) _warn "AGENTS.md가 심볼릭 링크라 collar 블록을 갱신하지 않았습니다 (collar-agents-sync exit 3)" ;;
  esac
  return 0
}

# ── 에이전트 실행 인자 파일 (설계 §16) ────────────────
# _agent_args_split <문자열> <dir> → reply. zsh 단어 규칙으로 나누고(${(z)}) 따옴표만 벗긴다(${(Q)}) —
#   변수·명령 치환·백틱·glob·~ 등 어떤 확장도 하지 않는다('$(touch x)'는 그 글자 그대로 인자가 된다).
#   앞에 더미 명령 단어를 붙여 나눈다 — 모든 단어가 인자 자리라 '{dir}'·'{' '!' 같은 예약어가 쪼개지거나 특별 취급되지 않는다.
#   {dir}은 따옴표를 벗긴 뒤 단어마다 <dir>로 바꾼다(따옴표 안 포함, 여러 번, 결과를 다시 나누지 않음).
#   파싱 실패면 비0: 닫히지 않은 따옴표·$( ${ ` (, 끝 역슬래시, 따옴표 밖 연산자(; | & < > ))
_agent_args_split() {
  local end=CMUXxENDx w
  local -a words=("${(z)${:-cmuxARGS $1 $end}}")
  # 끝 표지가 앞 단어에 먹혔다 = 닫히지 않은 따옴표·치환·괄호 또는 끝 역슬래시
  [[ "${words[1]}" == cmuxARGS && "${words[-1]}" == "$end" ]] || return 1
  reply=()
  for w in "${(@)words[2,-2]}"; do
    # 따옴표 밖 연산자 — (z)가 따로 떼어 낸 토큰 (예: ';' '|' '&&' '2>&' ')')
    [[ -z "${w//[0-9;|&<>()-]/}" && "$w" == *[\;\|\&\<\>\(\)]* ]] && return 1
    w="${(Q)w}"
    reply+=("${w//\{dir\}/$2}")
  done
}

# _agent_user_args <에이전트> <dir> → reply = 그 폴더·에이전트의 사용자 인자. 맞는 줄이 없으면 비0.
#   파일 $AGENT_ARGS_FILE, 줄 = 대상<TAB>에이전트<TAB>인자 (대상 = 절대경로 또는 *, 인자에 TAB이 더 있으면 공백으로 본다).
#   '#'로 시작하는 줄·빈 줄·필드 3개 미만·등록되지 않은 에이전트·절대경로가 아닌 대상은 조용히 무시. 줄 끝 CR은 뗀다.
#   대상 경로가 dir와 같은 폴더(문자열 같음 또는 -ef — 대소문자 무시 볼륨·심볼릭 링크)인 줄이 * 줄보다 우선이고 둘은
#   합치지 않는다. 같은 종류 안에서는 마지막 줄이 이긴다. 인자를 해석하지 못한 후보 줄은 경고 1줄 후 없는 줄로 본다.
_agent_user_args() {
  local agent="$1" dir="$2" f="$AGENT_ARGS_FILE" line target lagent rest n=0 have_hit=0 have_star=0
  local -a hit star
  [[ -f "$f" && -r "$f" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    (( n++ ))
    line="${line%$'\r'}"
    [[ "$line" == \#* || "$line" != *$'\t'*$'\t'* ]] && continue
    target="${line%%$'\t'*}" rest="${line#*$'\t'}"
    lagent="${rest%%$'\t'*}" rest="${rest#*$'\t'}"
    [[ "$lagent" == "$agent" ]] && _agent_known "$lagent" || continue
    [[ "$target" == '*' || ( "$target" == /* && ( "$target" == "$dir" || "$target" -ef "$dir" ) ) ]] || continue
    if ! _agent_args_split "$rest" "$dir"; then
      _warn "인자 파일 ${f}의 ${n}번째 줄을 해석하지 못해 무시합니다 (닫히지 않은 따옴표, 따옴표 밖 ; | & < > ( ) 등)"
      continue
    fi
    if [[ "$target" == '*' ]]; then
      star=("${reply[@]}") have_star=1
    else
      hit=("${reply[@]}") have_hit=1
    fi
  done < "$f"
  if (( have_hit )); then
    reply=("${hit[@]}")
  elif (( have_star )); then
    reply=("${star[@]}")
  else
    return 1
  fi
}

# 순서: 실행 파일 확인 → (비-claude) collar-agents-sync → 인자(파일 줄 또는 권한 프로파일) → 핸드오프 마커 소비 →
# 이어하기 판정 → 배너 1줄(인자 파일 줄을 쓰면 1줄 더) → 실행.
# 이전 대화가 있으면 이어하기 인자를 붙인다. 이어하기가 곧바로 실패하면(fastfail초 안에 rc 1~128로 종료)
# 새 대화로 1회만 다시 실행한다 — 예: claude 폴더에 요약(sdk-cli) 세션만 있어 --continue가 rc=1로 끝날 때.
# 신호로 끝난 경우(rc>128 — pane 닫기·Ctrl+C·kill)는 실패가 아니므로 다시 실행하지 않는다.
# 재실행 판단을 위해 exec 대신 자식으로 실행한다 (stdin/tty 상속, pane을 닫으면 SIGHUP이 함께 간다).
_launch_agent() {
  local agent="$1"
  _agent_call "$agent" label
  local label="$REPLY"

  if ! _agent_call "$agent" bin || ! command -v -- "$REPLY" >/dev/null 2>&1; then
    # 실행 파일이 없으면 pane을 닫지 않고 셸로 남긴다 — 탭과 나머지 복원은 그대로
    _warn "${label} 실행 파일을 찾지 못했습니다 (환경변수 CMUX_${(U)agent}_BIN 로 지정) — 셸로 전환합니다"
    exec zsh -i
  fi
  local bin="$REPLY"

  [[ "$agent" != claude ]] && _collar_agents_sync

  local -a perm resume fresh
  local uargs=0
  if _agent_user_args "$agent" "$PWD"; then
    # 인자 파일의 줄이 권한 프로파일 인자를 통째로 대신한다(CMUX_<A>_PERM보다 우선) — resume·fresh·fastfail 재실행 모두 (설계 §16)
    perm=("${reply[@]}")
    uargs=1
  else
    _agent_perm_profile "$agent"
    _agent_call "$agent" perm_args "$REPLY"; perm=("${reply[@]}")
  fi
  _agent_call "$agent" compose fresh "${perm[@]}"; fresh=("${reply[@]}")

  local resuming=0 banner
  if _handoff_marker_consume "$agent"; then
    banner="핸드오프 직후 — 새로 시작"
  elif REPLY="" && _agent_call "$agent" has_history "$PWD"; then
    banner="이전 대화 이어서 시작${REPLY:+ [$REPLY]}"
    _agent_call "$agent" compose resume "${perm[@]}"; resume=("${reply[@]}")
    resuming=1
  else
    banner="새로 시작"
  fi
  echo "${_c_gray}▶ ${label}: ${banner}${_c_reset}"
  # 인자는 print -r로(echo는 역슬래시를 해석한다), 한 단어씩 필요할 때만 따옴표 — 실제로 넘기는 argv 그대로
  if (( uargs )); then
    print -r -- "${(g::)_c_gray}  사용자 인자(${AGENT_ARGS_FILE}): ${${(j: :)${(q-)perm[@]}}:-(없음)}${(g::)_c_reset}"
  fi

  if (( resuming )); then
    _agent_call "$agent" fastfail
    local fastfail="$REPLY" t0=$SECONDS rc
    "$bin" "${resume[@]}"
    rc=$?
    (( rc >= 1 && rc <= 128 && SECONDS - t0 < fastfail )) || return $rc
  fi
  "$bin" "${fresh[@]}"
}

# 테스트용: 함수 정의만 로드하고 디스패처는 실행하지 않는다 (CMUX_SOURCE_ONLY=1 source bin/cmux)
# source일 때만 — env가 새어도 실행(pane의 'cmux launch' 등)은 영향받지 않게
[[ -n "$CMUX_SOURCE_ONLY" && "$ZSH_EVAL_CONTEXT" == *:file ]] && return 0

# ── 서브커맨드 ────────────────────────────────────────
case "$1" in
  -h|--help)
    echo "사용법: cmux [서브커맨드] [인수]"
    echo ""
    echo "  cmux               세션 연결 / 없으면 이전 탭 복원 / 기록 없으면 선택기"
    echo "  cmux <경로>        경로 직접 열기 (세션이 살아 있으면 탭 추가)"
    echo "  cmux pick          기록 무시하고 프로젝트 선택기 실행"
    echo "  cmux add [경로]    DEV_ROOT 외 경로 등록"
    echo "  cmux rm            등록 경로 제거"
    echo "  cmux list          전체 프로젝트 목록"
    echo "  cmux -l            zellij 세션 목록"
    echo "  cmux -k            세션 재시작 — 같은 탭 복원 + 각 탭 Claude 대화 이어서 (세션 안/밖 모두)"
    echo "  cmux kill          세션 종료만 (탭 기록은 보존 — 다음 'cmux'가 복원)"
    echo "  cmux launch [경로] (내부용) Claude Code 실행 — 대화 기록 있으면 --continue"
    echo "  cmux launch [경로] --agent <에이전트>  (내부용) 그 에이전트 실행 — 이전 대화 있으면 이어서"
    echo "  cmux -a <에이전트> [경로]  에이전트를 골라 열기 (경로 생략 시 현재 폴더, --agent 동의어)"
    echo "  cmux default [에이전트]   기본 에이전트 조회 / 설정 (설정 파일의 CMUX_DEFAULT_AGENT)"
    echo ""
    _default_agent
    echo "DEV_ROOT: $DEV_ROOT  (환경변수 CMUX_ROOT 로 변경)"
    echo "Claude:   $CLAUDE_BIN  (환경변수 CMUX_CLAUDE_BIN 로 변경)"
    echo "탭 기록:  $TABS_FILE  (환경변수 CMUX_TABS_FILE 로 변경)"
    echo "에이전트: ${CMUX_AGENTS[*]}  — 기본 $REPLY (${_cmux_default_src%% — *}; 환경변수 CMUX_AGENT > 설정 > claude)"
    echo "설정:     $CMUX_CONFIG_FILE  (zsh로 읽음, 환경변수 CMUX_CONFIG_FILE 로 변경 — 예: CMUX_DEFAULT_AGENT=codex, CMUX_CODEX_PERM=auto)"
    echo "         'cmux <경로>'·picker 선택 기본 = 기본 에이전트, picker는 프로젝트별 마지막 사용 에이전트를 미리 고른다"
    echo "인자 파일: $AGENT_ARGS_FILE  (환경변수 CMUX_AGENT_ARGS_FILE 로 변경 — 줄마다 '경로|*<TAB>에이전트<TAB>인자'(TAB 필수), 맞는 줄이 권한 인자 대신 — 이어하기 인자(resume --last 등)는 cmux가 붙이니 플래그만 적는다)"
    exit 0
    ;;

  default)
    # 기본 에이전트 조회 / 설정 — cmux default [에이전트]
    if [[ -z "$2" ]]; then
      _default_agent
      echo "기본 에이전트: $REPLY  (${_cmux_default_src})"
      exit 0
    fi
    if ! _agent_known "$2"; then
      _warn "알 수 없는 에이전트: '${2}' (사용 가능: ${CMUX_AGENTS[*]})" >&2
      exit 1
    fi
    if ! _config_set_default "$2"; then
      _warn "설정 파일을 쓰지 못했습니다: $CMUX_CONFIG_FILE" >&2
      exit 1
    fi
    _ok "기본 에이전트 = $2  (설정: $CMUX_CONFIG_FILE)"
    [[ -n "$CMUX_AGENT" && "$CMUX_AGENT" != "$2" ]] && _warn "지금은 환경변수 CMUX_AGENT=${CMUX_AGENT} 가 우선합니다"
    exit 0
    ;;

  -a|--agent)
    # 에이전트를 골라 열기 — cmux -a <에이전트> [경로] (경로 생략 시 현재 폴더)
    if ! _agent_known "$2"; then
      _warn "알 수 없는 에이전트: '${2}' (사용 가능: ${CMUX_AGENTS[*]}) — 사용법: cmux -a <에이전트> [경로]" >&2
      exit 1
    fi
    local atarget
    atarget=$(realpath "${3:-$PWD}" 2>/dev/null || echo "${3:-$PWD}")
    if [[ ! -d "$atarget" ]]; then
      _warn "디렉토리가 없습니다: $atarget" >&2
      exit 1
    fi
    _open_one "$atarget"$'\t'"$2"
    ;;

  launch)
    # zellij 에이전트 pane 진입점 — cmux launch [경로] [--agent <이름>] (기본 claude)
    shift
    local ldir="$PWD" lagent="claude"
    while (( $# )); do
      case "$1" in
        --agent) lagent="$2"; shift; (( $# )) && shift ;;
        *)       ldir="$1"; shift ;;
      esac
    done
    if ! _agent_known "$lagent"; then
      _warn "알 수 없는 에이전트: '${lagent}' (사용 가능: ${CMUX_AGENTS[*]})" >&2
      exit 1
    fi
    [[ -d "$ldir" ]] && cd "$ldir"
    _launch_agent "$lagent"
    exit $?
    ;;

  add)
    _ensure_extras_file
    local target="${2:-$PWD}"
    local abs_target
    abs_target=$(realpath "$target" 2>/dev/null || echo "$target")

    if [[ ! -d "$abs_target" ]]; then
      _warn "디렉토리가 없습니다: $abs_target" >&2
      exit 1
    fi

    if [[ "$abs_target" == "$DEV_ROOT/"* ]]; then
      _warn "DEV_ROOT($DEV_ROOT) 하위는 자동 감지됩니다 — 등록 불필요"
      exit 0
    fi

    if grep -qxF "$abs_target" "$EXTRAS_FILE" 2>/dev/null; then
      _warn "이미 등록됨: $abs_target"
    else
      echo "$abs_target" >> "$EXTRAS_FILE"
      _ok "등록됨: $abs_target"
    fi
    exit 0
    ;;

  rm|remove)
    _ensure_extras_file
    if [[ ! -s "$EXTRAS_FILE" ]]; then
      _warn "추가 등록된 프로젝트가 없습니다."
      exit 0
    fi

    local to_remove
    to_remove=$(cat "$EXTRAS_FILE" | fzf \
      --prompt="제거할 경로 선택 > " \
      --preview="ls -la {}" \
      --preview-window=right:50%:wrap \
      --height=50%)

    if [[ -n "$to_remove" ]]; then
      local tmpfile
      tmpfile=$(mktemp)
      grep -vxF "$to_remove" "$EXTRAS_FILE" > "$tmpfile" && mv "$tmpfile" "$EXTRAS_FILE"
      _ok "제거됨: $to_remove"
    else
      _info "취소됨"
    fi
    exit 0
    ;;

  list)
    echo "DEV_ROOT: ${_c_cyan}$DEV_ROOT${_c_reset}"
    echo ""
    _project_list | while IFS= read -r p; do
      local marker="${_c_green}●${_c_reset}"
      local tag=""
      [[ ! -d "$p" ]] && marker="${_c_yellow}✗${_c_reset}" && tag=" ${_c_yellow}(없음)${_c_reset}"
      [[ -d "$p/.git" ]] && tag="${_c_gray} (git)${_c_reset}"
      echo "  $marker $(basename "$p")${tag}"
    done
    exit 0
    ;;

  -l|--list-sessions)
    echo "=== Zellij 세션 목록 ==="
    zellij list-sessions 2>/dev/null || echo "(실행 중인 세션 없음)"
    exit 0
    ;;

  -k|--restart|restart)
    # 재시작: 현재 탭 구성 기록 → 종료 → 같은 탭으로 재생성 (Claude 대화 이어서)
    _tabs_sync_live

    if [[ -n "$ZELLIJ" ]]; then
      # 세션 안에서는 이 pane도 함께 사라진다 — 마커를 남기면 터미널의 cmux(_run_client)가
      # 클라이언트 종료 직후 같은 탭으로 재생성한다. (cmux 없이 attach한 경우는 다음 'cmux'가 복원)
      mkdir -p "$(dirname "$RESTART_MARKER")"
      touch "$RESTART_MARKER"
      _info "세션 재시작 — 같은 탭으로 복원됩니다. (자동 복원이 안 되면 셸에서 'cmux')"
      sleep 0.3
      zellij delete-session "$SESSION_NAME" --force 2>/dev/null \
        || zellij kill-session "$SESSION_NAME" 2>/dev/null \
        || true
      exit 0
    fi

    zellij delete-session "$SESSION_NAME" --force 2>/dev/null \
      || zellij kill-session "$SESSION_NAME" 2>/dev/null \
      || true

    # 서버가 완전히 사라질 때까지 대기 (최대 ~6초)
    local waited=0
    while _session_alive && (( waited < 60 )); do
      sleep 0.1
      (( waited++ ))
    done
    _clear_session_cache

    if _restore_tabs; then
      exit 0
    fi
    _warn "복원할 탭 기록 없음 — 프로젝트를 선택하세요."
    _pick_flow
    ;;

  kill|-K|--kill)
    # 종료만 — 탭 기록은 남겨서 다음 'cmux'가 복원
    _tabs_sync_live
    if zellij delete-session "$SESSION_NAME" --force 2>/dev/null \
       || zellij kill-session "$SESSION_NAME" 2>/dev/null; then
      _ok "세션 종료: $SESSION_NAME (탭 기록 보존 — 다음 'cmux'가 복원)"
    else
      _warn "세션이 없거나 이미 종료됨"
    fi
    exit 0
    ;;

  pick|new)
    # 기록 무시하고 새 구성 선택
    _pick_flow
    ;;

  "")
    if [[ -z "$ZELLIJ" ]]; then
      # 실행 중인 세션이 있으면 picker 없이 바로 attach
      if _session_alive; then
        _info "기존 세션에 연결 중: $SESSION_NAME"
        _run_client attach "$SESSION_NAME"
      fi
      # 세션이 없으면 이전 탭 구성을 그대로 복원
      if _restore_tabs; then
        exit 0
      fi
    fi

    _pick_flow
    ;;

  *)
    # cmux PATH — 직접 경로로 열기 (기본 에이전트 — 마지막 사용 기억은 적용하지 않는다, 설계 D5)
    local target
    target=$(realpath "$1" 2>/dev/null || echo "$1")

    if [[ ! -d "$target" ]]; then
      _warn "디렉토리가 없습니다: $target" >&2
      exit 1
    fi

    _default_agent
    _open_one "$target"$'\t'"$REPLY" "$2"
    ;;
esac
