#!/usr/bin/env python3
"""
cmux-picker — 수평 탭 스타일 프로젝트 피커
curses로 /dev/tty 직접 제어 → command substitution 안에서도 동작
선택된 프로젝트를 stdout(원본 파이프)으로 한 줄씩 출력:
  유효 에이전트가 설정된 default면 `경로`만(구버전 호환), 다르면 `경로<TAB>에이전트`

에이전트 선택 입력(cmux가 env로 넘김, 모두 선택 사항 — 없으면 claude 하나 = 기존 화면·출력 그대로):
  CMUX_PICKER_AGENTS         등록된 에이전트(공백 구분, 순서 = a/Tab 순환 순서)
  CMUX_PICKER_DEFAULT_AGENT  설정된 default (기본 claude)
  CMUX_PICKER_PREFS_FILE     프로젝트별 마지막 사용 에이전트(`경로<TAB>에이전트`) — 읽기만 한다
"""

import curses
import os
import sys

DEV_ROOT = os.environ.get("CMUX_ROOT", os.path.expanduser("~/Documents/dev/ai"))
EXTRAS_FILE = os.path.expanduser("~/.config/cmux/projects")

KEY_TAB = 9


def get_projects():
    projects = []

    if os.path.isdir(DEV_ROOT):
        try:
            entries = sorted(os.listdir(DEV_ROOT), key=lambda n: n.lower())
            for name in entries:
                if name.startswith("."):
                    continue
                full = os.path.join(DEV_ROOT, name)
                if os.path.isdir(full):
                    projects.append(full)
        except PermissionError:
            # macOS TCC가 ~/Documents 접근을 차단하면 여기로 온다 — 조용히 삼키면
            # picker가 이유 없이 즉시 종료된 것처럼 보이므로 반드시 알린다
            print(
                f"⚠ 접근 불가: {DEV_ROOT} — macOS TCC 차단 추정.\n"
                "  시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한에\n"
                "  zellij(또는 사용 중인 터미널 앱)를 추가한 뒤 다시 실행하세요.",
                file=sys.stderr,
            )

    if os.path.isfile(EXTRAS_FILE):
        prefix = DEV_ROOT.rstrip("/") + "/"
        with open(EXTRAS_FILE) as f:
            for line in f:
                p = line.strip()
                if p and not p.startswith(prefix) and os.path.isdir(p) and p not in projects:
                    projects.append(p)

    return projects


# ── 에이전트 선택 (curses와 무관한 순수 로직 — tests/unit/t30_picker_unit.zsh) ──
def parse_agents(value):
    """CMUX_PICKER_AGENTS(공백 구분) → 등록 순서 유지·중복 제거. 비어 있으면 claude 하나."""
    agents = []
    for a in value.split():
        if a not in agents:
            agents.append(a)
    return agents or ["claude"]


def parse_prefs(path, agents):
    """마지막 사용 에이전트 파일(`경로<TAB>에이전트` 줄들) → {경로: 에이전트}.

    읽기 전용 — 파일이 없거나 읽을 수 없으면 기억 없음. 같은 경로가 여러 줄이면 마지막 줄이고,
    그 에이전트가 등록 목록에 없으면(미설치 등) 기억 없음으로 취급해 선택 기본을 따른다.
    """
    prefs = {}
    if not path:
        return prefs
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                p, sep, a = line.rstrip("\n").partition("\t")
                if sep and p:
                    prefs[p] = a.strip()
    except (OSError, UnicodeDecodeError):
        return {}
    return {p: a for p, a in prefs.items() if a in agents}


def compute_effective_agent(path, explicit, prefs, base):
    """유효 에이전트 = a로 명시 변경 > 기억값 > 선택 기본.

    기억 파일은 cmux가 realpath로 기록하므로 picker 경로(CMUX_ROOT 기준 논리 경로)의 물리 경로도 찾는다.
    """
    if path in explicit:
        return explicit[path]
    return prefs.get(path) or prefs.get(os.path.realpath(path)) or base


def next_agent(agents, current):
    """등록 순서대로 다음 에이전트 (목록에 없으면 첫 항목)."""
    if current not in agents:
        return agents[0]
    return agents[(agents.index(current) + 1) % len(agents)]


def agent_badge(agent, base):
    """선택 기본과 다를 때만 `[codex]` 같은 배지, 같으면 빈 문자열."""
    return "" if agent == base else f"[{agent}]"


def serialize_selection(paths, agent_of, default):
    """출력 줄 — 유효 에이전트가 설정된 default면 `경로`만(구버전 호환), 다르면 `경로<TAB>에이전트`."""
    lines = []
    for p in paths:
        a = agent_of(p)
        lines.append(p if a == default else f"{p}\t{a}")
    return lines


class AgentChoice:
    """picker 한 번 동안의 에이전트 선택 상태."""

    def __init__(self, agents, default, prefs):
        self.agents = agents
        # 설정된 default — 출력에서 `경로`만 쓸지의 기준. 등록 목록에 없어도 그대로 둔다
        # (그 경우 모든 항목이 `경로<TAB>에이전트`로 나가 cmux가 default로 오해할 여지가 없다)
        self.default = default
        self.base = default if default in agents else agents[0]  # 선택 기본 — Tab으로 순환
        self.prefs = prefs
        self.explicit = {}  # a로 명시 변경한 항목: {경로: 에이전트}

    @classmethod
    def from_env(cls, env):
        agents = parse_agents(env.get("CMUX_PICKER_AGENTS", ""))
        default = env.get("CMUX_PICKER_DEFAULT_AGENT", "").strip() or "claude"
        return cls(agents, default, parse_prefs(env.get("CMUX_PICKER_PREFS_FILE", ""), agents))

    @property
    def enabled(self):
        """등록 에이전트가 2개 이상일 때만 안내줄·a/Tab 키가 동작한다 (1개면 기존 화면 그대로)."""
        return len(self.agents) > 1

    def effective(self, path):
        return compute_effective_agent(path, self.explicit, self.prefs, self.base)

    def badge(self, path):
        return agent_badge(self.effective(path), self.base)

    def on_key(self, k, path):
        """a: 커서 항목 에이전트 순환(명시 변경), Tab: 선택 기본 순환. 그 외 키·등록 1개면 무시."""
        if not self.enabled:
            return
        if k == ord("a"):
            self.explicit[path] = next_agent(self.agents, self.effective(path))
        elif k == KEY_TAB:
            self.base = next_agent(self.agents, self.base)

    def output_lines(self, paths):
        return serialize_selection(paths, self.effective, self.default)


def compute_all_positions(names, w, badges):
    """모든 항목의 논리적 (logical_row, col, idx, tab_w) 위치 계산."""
    positions = []
    row, col = 0, 2

    for i, name in enumerate(names):
        label = f" {name} " + (f"{badges[i]} " if badges[i] else "")
        tab_w = len(label) + 2

        if col + tab_w > w - 2:
            row += 1
            col = 2

        positions.append((row, col, i, tab_w))
        col += tab_w + 1

    return positions


def draw(stdscr, names, cursor, selected, scroll_offset, all_positions, badges, base):
    """base: 선택 기본 에이전트 — 등록 에이전트가 1개면 None(안내 없이 기존 화면 그대로)."""
    stdscr.erase()
    h, w = stdscr.getmaxyx()

    C_TITLE    = curses.color_pair(1)
    C_CURSOR   = curses.color_pair(2)
    C_SELECTED = curses.color_pair(3)
    C_NORMAL   = curses.color_pair(4)
    C_DIM      = curses.color_pair(5)
    C_ACCENT   = curses.color_pair(6)
    C_BADGE    = curses.color_pair(7)

    # ── 타이틀 ────────────────────────────────────────
    title = f" cmux — 프로젝트 선택 ({len(names)}개) "
    try:
        stdscr.addstr(0, max(0, (w - len(title)) // 2), title, C_TITLE | curses.A_BOLD)
    except curses.error:
        pass

    # ── 에이전트 안내 (빈 row 1 — 등록 2개 이상일 때만) ──
    if base:
        try:
            stdscr.addstr(1, 2, "기본 에이전트: ", C_DIM)
            stdscr.addstr(base, C_BADGE | curses.A_BOLD)
            stdscr.addstr("   a:에이전트 Tab:기본", C_DIM)
        except curses.error:
            pass

    # ── 가시 영역: screen row 2 ~ h-4 ────────────────
    visible_height = h - 5

    if visible_height < 1:
        return scroll_offset

    # ── 스크롤 오프셋 자동 조정 ──────────────────────
    max_logical_row = max(p[0] for p in all_positions) if all_positions else 0
    cursor_pos = next((p for p in all_positions if p[2] == cursor), None)
    if cursor_pos:
        clr = cursor_pos[0]
        if clr < scroll_offset:
            scroll_offset = clr
        elif clr >= scroll_offset + visible_height:
            scroll_offset = clr - visible_height + 1
    max_scroll = max(0, max_logical_row - visible_height + 1)
    scroll_offset = max(0, min(scroll_offset, max_scroll))

    # ── 스크롤 표시 ───────────────────────────────────
    if scroll_offset > 0:
        try:
            stdscr.addstr(1, w - 7, " ↑more ", C_DIM)
        except curses.error:
            pass
    if max_logical_row >= scroll_offset + visible_height:
        try:
            stdscr.addstr(h - 3, w - 7, " ↓more ", C_DIM)
        except curses.error:
            pass

    # ── 항목 렌더링 ───────────────────────────────────
    for logical_row, col, i, tab_w in all_positions:
        screen_row = logical_row - scroll_offset + 2
        if screen_row < 2 or screen_row > h - 4:
            continue

        label = f" {names[i]} "
        badge = f"{badges[i]} " if badges[i] else ""  # 선택 기본과 다른 에이전트만 `[codex] `
        end = col + 1 + len(label) + len(badge)
        try:
            if i == cursor:
                stdscr.addstr(screen_row, col,     "▶",    C_ACCENT)
                stdscr.addstr(screen_row, col + 1, label,  C_CURSOR | curses.A_BOLD)
                stdscr.addstr(screen_row, end,     "◀",    C_ACCENT)
            elif i in selected:
                stdscr.addstr(screen_row, col,     "●",    C_SELECTED | curses.A_BOLD)
                stdscr.addstr(screen_row, col + 1, label,  C_SELECTED | curses.A_BOLD)
                stdscr.addstr(screen_row, end,     "●",    C_SELECTED | curses.A_BOLD)
            else:
                stdscr.addstr(screen_row, col,     " ",    C_NORMAL)
                stdscr.addstr(screen_row, col + 1, label,  C_NORMAL)
                stdscr.addstr(screen_row, end,     " ",    C_NORMAL)
            if badge:
                stdscr.addstr(screen_row, col + 1 + len(label), badge, C_BADGE | curses.A_BOLD)
        except curses.error:
            pass

    # ── 구분선 + 키 설명 ──────────────────────────────
    sel_str = f" ● {len(selected)}개 선택" if selected else ""
    keys_left = " ←→↑↓/hjkl:이동   Space:선택   Enter:열기   Esc:취소"
    try:
        stdscr.addstr(h - 2, 0, "─" * w, C_DIM)
        stdscr.addstr(h - 1, 0, keys_left, C_DIM)
        if sel_str:
            stdscr.addstr(h - 1, max(0, w - len(sel_str) - 1), sel_str,
                          C_SELECTED | curses.A_BOLD)
    except curses.error:
        pass

    stdscr.refresh()
    return scroll_offset


# 일반 커서 모드 방향키의 마지막 바이트 → curses 키 코드
_ARROW_KEYS = {
    ord("A"): curses.KEY_UP,
    ord("B"): curses.KEY_DOWN,
    ord("C"): curses.KEY_RIGHT,
    ord("D"): curses.KEY_LEFT,
}


def read_key(stdscr):
    """getch 래퍼 — terminfo에 없는 이스케이프 시퀀스를 직접 해석.

    terminfo에는 애플리케이션 모드 방향키(ESC O A~D)만 정의돼 있어, 터미널이
    일반 커서 모드로 보내는 ESC [ A~D 는 curses가 인식하지 못하고 27(Esc)만
    돌려준다 → 방향키가 취소로 처리돼 picker가 이유 없이 닫혔다.
    curses.define_key()는 macOS 시스템 python3의 _curses(ncurses 6.0)에
    없으므로 Esc 뒤에 남은 바이트를 직접 읽어 매핑한다.
    """
    k = stdscr.getch()
    if k != 27:
        return k

    stdscr.timeout(25)  # 뒤따르는 바이트만 잠깐 확인 — 없으면 진짜 Esc
    try:
        nxt = stdscr.getch()
        if nxt in (ord("["), ord("O")):
            return _ARROW_KEYS.get(stdscr.getch(), -1)  # 모르는 시퀀스는 무시
        return 27  # Esc 단독 / Esc + 다른 키 → 취소
    finally:
        stdscr.timeout(-1)


def picker_ui(stdscr, projects, choice):
    names = [os.path.basename(p) for p in projects]

    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()

    curses.init_pair(1, curses.COLOR_CYAN,   -1)
    curses.init_pair(2, curses.COLOR_BLACK,  curses.COLOR_CYAN)
    curses.init_pair(3, curses.COLOR_GREEN,  -1)
    curses.init_pair(4, curses.COLOR_WHITE,  -1)
    curses.init_pair(5, 8,                   -1)
    curses.init_pair(6, curses.COLOR_YELLOW, -1)
    curses.init_pair(7, curses.COLOR_MAGENTA, -1)

    cursor = 0
    selected = set()
    scroll_offset = 0

    while True:
        h, w = stdscr.getmaxyx()
        badges = [choice.badge(p) for p in projects]
        all_positions = compute_all_positions(names, w, badges)

        scroll_offset = draw(stdscr, names, cursor, selected, scroll_offset, all_positions,
                             badges, choice.base if choice.enabled else None)

        k = read_key(stdscr)

        if k in (27, ord("q")):  # Esc, q (Ctrl+C는 SIGINT로 들어와 main()에서 처리)
            return []

        elif k in (10, 13):  # Enter
            if selected:
                return [projects[i] for i in sorted(selected)]
            return [projects[cursor]]

        elif k == ord(" "):  # Space — 토글 후 다음으로
            if cursor in selected:
                selected.discard(cursor)
            else:
                selected.add(cursor)
            cursor = (cursor + 1) % len(names)

        elif k in (curses.KEY_LEFT, ord("h")):
            cursor = (cursor - 1) % len(names)

        elif k in (curses.KEY_RIGHT, ord("l")):
            cursor = (cursor + 1) % len(names)

        elif k in (curses.KEY_UP, ord("k")):
            curr = next((p for p in all_positions if p[2] == cursor), None)
            if curr:
                above = [p for p in all_positions if p[0] == curr[0] - 1]
                if above:
                    cursor = min(above, key=lambda p: abs(p[1] - curr[1]))[2]

        elif k in (curses.KEY_DOWN, ord("j")):
            curr = next((p for p in all_positions if p[2] == cursor), None)
            if curr:
                below = [p for p in all_positions if p[0] == curr[0] + 1]
                if below:
                    cursor = min(below, key=lambda p: abs(p[1] - curr[1]))[2]

        else:  # a: 커서 항목 에이전트 순환, Tab: 선택 기본 순환 (그 외 키는 무시)
            choice.on_key(k, projects[cursor])

    return []


def main():
    # curses 기본 ESCDELAY(1000ms) 때문에 Esc 반응이 1초 늦다. initscr 이전에
    # 잡아야 적용되므로 wrapper 호출 전에 설정한다 (25ms → 체감 즉시).
    os.environ.setdefault("ESCDELAY", "25")

    projects = get_projects()
    if not projects:
        print(f"⚠ 표시할 프로젝트가 없습니다 (DEV_ROOT: {DEV_ROOT})", file=sys.stderr)
        sys.exit(1)

    choice = AgentChoice.from_env(os.environ)

    old_stdin  = os.dup(0)
    old_stdout = os.dup(1)

    tty = open("/dev/tty", "r+b", buffering=0)
    os.dup2(tty.fileno(), 0)
    os.dup2(tty.fileno(), 1)

    try:
        results = curses.wrapper(picker_ui, projects, choice)
    except KeyboardInterrupt:
        # cbreak(ISIG 유지) 상태라 Ctrl+C는 getch()에서 KeyboardInterrupt로 터진다.
        # 트레이스백 + 비정상 종료코드를 내면 호출부(bin/cmux)가 "프로젝트 선택기
        # 실행 실패"로 오인하므로 Esc와 동일하게 조용히 취소 처리한다.
        results = []
    finally:
        os.dup2(old_stdin,  0)
        os.dup2(old_stdout, 1)
        os.close(old_stdin)
        os.close(old_stdout)
        tty.close()

    for line in choice.output_lines(results):
        sys.stdout.write(line + "\n")
    sys.stdout.flush()


if __name__ == "__main__":
    main()
