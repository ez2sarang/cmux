// Claude Code 프로젝트 레이아웃
//
// ┌──────────────────────────────────────────────────┐
// │ [1] cmux-bar — 탭 줄(1↔2줄 토글) + 툴바 (3행)   │
// ├──────────────────────────┬───────────────────────┤
// │ [2] claude (좌 65%)      │ [3] 파일트리 (우상)   │
// │                          ├───────────────────────┤
// │                          │ [4] 터미널 (우하)     │
// ├──────────────────────────┴───────────────────────┤
// │ [5] 상태 바 — 모드/단축키 안내                  │
// └──────────────────────────────────────────────────┘
//
// [1]은 직접 그리는 cmux-bar(size=3 → 내용 2행, zellij:tab-bar 플러그인 없음):
// 접힘 = 탭 1줄 + 툴바, 펼침 = 탭 2줄. ▾/▴ 클릭 또는 t 키로 토글.

layout {
    default_tab_template {
        pane size=3 borderless=true {
            command "/bin/zsh"
            args "-c" "while true; do CMUX_BAR_BIN; sleep 1; done"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab focus=true {
        pane split_direction="vertical" {
            pane size="65%" focus=true name="claude" {
                command "CMUX_BIN"
                args "launch"
            }
            pane size="35%" split_direction="horizontal" {
                pane size="55%" name="files" {
                    command "/bin/zsh"
                    args "-c" "eza --tree --level 2 --icons --color=always . 2>/dev/null || ls -la .; exec zsh -i"
                }
                pane size="45%" name="terminal"
            }
        }
    }
}
