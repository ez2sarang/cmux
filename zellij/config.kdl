// Zellij config — cmux workspace
// Docs: https://zellij.dev/documentation/

mouse_mode true

// 포커스 없는 pane을 클릭하면 그 클릭도 pane 안으로 보낸다 (기본 false = 첫 클릭은 포커스 이동에만 쓰이고 앱에 안 전달됨).
// cmux-bar(상단 탭 줄)의 탭 이름·토글·버튼이 첫 클릭에 동작하려면 필요하다. 서버 시작 때만 읽힌다 —
// 이미 떠 있는 세션에는 적용되지 않으므로 cmux -k 등으로 세션을 새로 만든 뒤부터 유효하다.
mouse_click_through true
scroll_buffer_size 10000
copy_on_select true

// theme_dir "~/.config/zellij/themes"
// theme "catppuccin-mocha"

default_layout "claude-project"

// cmux가 세션 관리를 담당하므로 비활성화
session_serialization false

show_startup_tips false

// Ghostty + macos-option-as-alt 와의 충돌 방지
// Alt+문자/숫자는 이 조합에서 동작하지 않음 (Alt+화살표는 동작)
use_kitty_keyboard_protocol false

keybinds clear-defaults=false {
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    shared_except "locked" {
        // 세션 detach — 세션 유지하고 터미널로 나가기
        // 재접속: cmux 실행 (세션 있으면 자동 attach)
        // Ctrl+b (영문) / Ctrl+ㅠ (한글 입력 상태)
        bind "Ctrl b" "Ctrl ㅠ" { Detach; }

        // 탭 순서 변경 — 현재 탭을 좌/우로 한 칸 이동
        bind "Ctrl Shift Left"  { MoveTab "Left"; }
        bind "Ctrl Shift Right" { MoveTab "Right"; }

        // Ctrl+O를 Claude Code로 패스스루 (app:toggleTranscript)
        // zellij 기본값: Ctrl+O → Session 모드 (Claude Code에 전달 안 됨)
        // Session 모드는 Ctrl+Shift+O로 이전
        unbind "Ctrl o"
        bind "Ctrl Shift O" { SwitchToMode "Session"; }
    }
}
